NEXT_PUBLIC_SITE_URL=https://seu-dominio.com
NEXT_PUBLIC_USE_WEATHER_MOCK=false
NEXT_PUBLIC_WEATHER_MOCK_SCENARIO=normal
OPENWEATHER_API_KEY=coloque_sua_chave_aqui

# Banco de dados MySQL (ver docker-compose.yml para subir localmente)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tere_app
DB_PASSWORD=tereemfoco123
DB_NAME=tere_em_foco
# Usada apenas pelo docker-compose.yml para criar o container do MySQL
DB_ROOT_PASSWORD=tereemfoco_root

# Opcional: senha do usuário administrador criado automaticamente no
# primeiro `npm run dev` (login: admin@tereemfoco.com.br). Se não definir,
# a senha padrão é "tereemfoco123".
ADMIN_SENHA_PADRAO=tereemfoco123
